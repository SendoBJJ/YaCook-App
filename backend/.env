MONGO_URL="mongodb://localhost:27017"
DB_NAME="yacook_database"

# Authentication
SECRET_KEY="your-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="https://your-app.com/auth/google/callback"

# Apple OAuth (feature flagged)
APPLE_CLIENT_ID="your-apple-client-id"
APPLE_TEAM_ID="your-apple-team-id"
APPLE_KEY_ID="your-apple-key-id"
APPLE_PRIVATE_KEY="your-apple-private-key"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_UPLOAD_PRESET="yacook_uploads"

# AI/LLM
EMERGENT_LLM_KEY="sk-emergent-4E402B28878B88c88B"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Open Food Facts
OPENFOODFACTS_BASE_URL="https://world.openfoodfacts.org/api/v2"
CACHE_TTL_DAYS=30

# App Configuration
APP_ENV="development"
DEFAULT_LANGUAGE="fr"
USER_AGENT="YaCook/1.0 (contact@yacook.app)"

# Feature Flags
APPLE_SIGNIN_ENABLED=false
ANALYTICS_ENABLED=true
AI_FEATURES_ENABLED=true